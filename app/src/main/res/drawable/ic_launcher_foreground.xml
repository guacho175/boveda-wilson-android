<?xml version="1.0" encoding="utf-8"?>
<!-- Símbolo orbital de orbynex.digital (manual §4): un núcleo con "+" rodeado de
     órbitas y un nodo. El acento fucsia/magenta aparece en un único nodo, nunca
     como color dominante (regla 70/20/10, manual §7). Vectorial, sin red ni
     dependencias externas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="orbit_back"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="55">
        <path
            android:strokeColor="#00D4FF"
            android:strokeWidth="2"
            android:strokeAlpha="0.45"
            android:fillColor="#00000000"
            android:pathData="M24,54 a30,10 0 1,0 60,0 a30,10 0 1,0 -60,0 Z" />
    </group>

    <group
        android:name="orbit_front"
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:strokeColor="#00D4FF"
            android:strokeWidth="2.6"
            android:fillColor="#00000000"
            android:pathData="M24,54 a30,13 0 1,0 60,0 a30,13 0 1,0 -60,0 Z" />
        <path
            android:fillColor="#D946EF"
            android:pathData="M80,54 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    </group>

    <path
        android:fillColor="#1463FF"
        android:strokeColor="#00D4FF"
        android:strokeWidth="1.4"
        android:pathData="M43,54 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" />

    <path
        android:fillColor="#F5F8FF"
        android:pathData="M48,52.5h12v3h-12z" />
    <path
        android:fillColor="#F5F8FF"
        android:pathData="M52.5,48v12h3v-12z" />

</vector>
